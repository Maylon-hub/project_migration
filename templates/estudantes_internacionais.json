        "blocks": {
          "2d94fab7-6560-4f87-ae1a-483d834a01b9": {
            "blocks": {
              "06752a42-0ad5-4c84-9a09-28014e3f9c16": {
                "@type": "slate",
                "plaintext": "  A SRInter, em parceria com a comunidade universitária, como o Coletivo de Estudantes Internacionais (CEI),pró-reitorias, centros acadêmicos e unidades de cultura e extensão, promove atividades e eventos dedicados à integração cultural e social dos estudantes internacionais, como recepções, encontros multiculturais e ações de convivência. Entre essas ações, destaca-se o Programa de Apadrinhamento, no qual estudantes da UFSCar atuamcomo ponte entre a vida cotidiana no Brasil e o ambiente acadêmico.",
                "value": [
                  {
                    "children": [
                      {
                        "text": ""
                      },
                      {
                        "children": [
                          {
                            "text": ""
                          }
                        ],
                        "type": "b"
                      },
                      {
                        "text": "A SRInter, em parceria com a comunidade universitária, como o Coletivo de Estudantes Internacionais (CEI),pró-reitorias, centros acadêmicos e unidades de cultura e extensão, promove atividades e eventos dedicados à integração cultural e social dos estudantes internacionais, como recepções, encontros multiculturais e ações de convivência. Entre essas ações, destaca-se o Programa de Apadrinhamento, no qual estudantes da UFSCar atuamcomo ponte entre a vida cotidiana no Brasil e o ambiente acadêmico. "
                      }
                    ],
                    "type": "p"
                  }
                ]
